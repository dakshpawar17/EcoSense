# Database connection
DATABASE_URL="file:./ecosense.db"

# Groq API Key (for real-time Llama 3.3 AI report generation)
# If omitted or invalid, EcoSense automatically uses its intelligent fallback coach engine.
GROQ_API_KEY="your_groq_api_key_here"

# Server Port
PORT=5001

# Node Environment
NODE_ENV="development"
