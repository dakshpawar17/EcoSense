generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Entry {
  id               String   @id @default(uuid())
  clientUuid       String?  @unique
  userEmail        String?
  userId           String?
  createdAt        DateTime @default(now())
  transportMode    String   @default("car")
  transportKm      Float    @default(0.0)
  energyKwh        Float    @default(0.0)
  energySource     String   @default("grid")
  dietType         String   @default("mixed")
  meals            Int      @default(3)
  shoppingOrders   Int      @default(0)
  shoppingCategory String   @default("general")
  co2Transport     Float    @default(0.0)
  co2Energy        Float    @default(0.0)
  co2Food          Float    @default(0.0)
  co2Shopping      Float    @default(0.0)
  co2Total         Float    @default(0.0)
  ecoScore         Int      @default(75)

  // AI Auto-Tracking metadata
  isAutoTracked    Boolean  @default(false)
  confidenceScore  Float?

  @@index([createdAt])
  @@index([userEmail])
}

model UserCorrection {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  predictedMode   String
  actualMode      String
  speedKmH        Float    @default(0.0)
  distanceKm      Float    @default(0.0)
  confidenceScore Float    @default(0.8)
  reason          String?

  @@index([createdAt])
}

model TelemetrySyncLog {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  provider      String   @default("Apple HealthKit")
  stepCount     Int      @default(0)
  distanceKm    Float    @default(0.0)
  co2OffsetKg   Float    @default(0.0)
  status        String   @default("SUCCESS")

  @@index([createdAt])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatar    String?
  provider  String   @default("demo")
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}
