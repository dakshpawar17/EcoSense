{
  "name": "ecosense-monorepo",
  "version": "1.0.0",
  "description": "EcoSense - AI Carbon Footprint Analyzer",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "test": "npm run test --prefix backend",
    "install:all": "npm install"
  },
  "dependencies": {
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
